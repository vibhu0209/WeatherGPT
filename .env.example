OPENWEATHER_API_KEY=
WEATHERAPI_KEY=
IMD_ENABLED=false
CAP_ALERT_URL=
CAP_ALERT_ALLOWED_HOSTS=
# Legacy Gemini keys — unused by active chat runtime (kept for older env files).
GEMINI_API_KEY=
GEMINI_MODEL=
# Groq powers online conversational reasoning and tool orchestration.
# Meteorological facts remain grounded in WeatherGPT tools / providers.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
BHASHINI_COMPUTE_URL=
BHASHINI_ALLOWED_HOSTS=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_TRANSLATION_SERVICE_ID=
GOOGLE_TRANSLATE_API_KEY=
# Place search — zero-cost by default (Open-Meteo + popular cities; optional Mappls).
# Google Places stays in code but is OFF unless GOOGLE_PLACES_ENABLED=true AND a key is set.
# Prefer GOOGLE_PLACES_API_KEY. GOOGLE_MAPS_API_KEY is a legacy alias when Places is empty.
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
MAPPLS_ACCESS_TOKEN=
CORS_ORIGINS=
REDIS_URL=
# Optional FCM push — leave empty to keep push disabled
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional SMS delivery — leave empty to keep SMS disabled
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
